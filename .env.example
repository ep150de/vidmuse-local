# Generated by VidMuse setup wizard / copy to .env
# cp .env.example .env

# local | cloud
VIDMUSE_MODE=cloud

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
OUTPUT_DIR=./outputs

# --- LLM ---
# Cloud mode defaults OLLAMA_URL to https://ollama.com
# OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
# Prefer free/entry-tier cloud models. Large tags like gpt-oss:120b often need a paid plan.
OLLAMA_MODEL=deepseek-v4-flash

# Optional override: llamacpp | ollama | opencode-go
# LLM_PROVIDER=ollama
# Only used when OPENCODE_API_KEY is set
LLM_FALLBACK=opencode-go

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# --- ComfyUI / Comfy Cloud ---
COMFYUI_BACKEND=cloud
# COMFYUI_URL=http://localhost:8188
COMFY_CLOUD_URL=https://cloud.comfy.org
COMFY_CLOUD_API_KEY=
# Optional overrides — generation stays inside ComfyUI + your LLM only
# COMFY_CHECKPOINT_TURBO=z_image_turbo_bf16.safetensors
# COMFY_ZIMAGE_CLIP=qwen_3_4b.safetensors
# COMFY_ZIMAGE_VAE=ae.safetensors
# Video backend: ltx23 (default, higher quality A/V) | humo (classic lip-sync)
COMFY_VIDEO_BACKEND=ltx23
# LTX-2.3 distilled image+audio→video
# COMFY_LTX_CKPT=ltx-2.3-22b-distilled-fp8.safetensors
# COMFY_LTX_TEXT_ENCODER=gemma_3_12B_it.safetensors
# COMFY_LTX_FPS=24
# COMFY_LTX_STEPS=8
# COMFY_LTX_CFG=1.0
# COMFY_LTX_I2V_STRENGTH=0.85
# COMFY_LTX_CLIP_SECONDS=4.0
# COMFY_LTX_MAX_FRAMES=97
# COMFY_LTX_AUDIO_IDENTITY=1.0
# Fallback HuMo lip-sync (used when COMFY_VIDEO_BACKEND=humo or LTX fails):
# COMFY_HUMO_UNET=humo_17B_fp8_e4m3fn.safetensors
# Must be Whisper (not wav2vec) — HuMo reads encoder layer 32:
# COMFY_HUMO_AUDIO_ENC=whisper_large_v3_fp16.safetensors
# COMFY_HUMO_CLIP_SECONDS=2.0
# COMFY_HUMO_FPS=25
# COMFY_IMAGE_BACKEND=sdxl  # force SDXL turbo instead of Z-Image

# --- Full-song pipeline ---
# Target seconds per storyboard scene (3–4 min songs → more scenes)
VIDMUSE_SCENE_SECONDS=6
VIDMUSE_MAX_SCENES=48
VIDMUSE_MIN_SCENES=8
# How short generated clips fill their longer scene slot: loop | freeze | stretch
VIDMUSE_CLIP_FILL=loop
