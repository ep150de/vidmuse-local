# SceneMux — copy to .env
# cp .env.example .env

# local | cloud
VIDMUSE_MODE=cloud

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
OUTPUT_DIR=./outputs

# --- LLM ---
# Cloud mode defaults OLLAMA_URL to https://ollama.com
# OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
# Prefer free-tier Ollama Cloud models. deepseek-v4-flash/pro require Pro subscription.
OLLAMA_MODEL=gemma4:31b
# Comma-separated free-tier alternates tried automatically on 403/subscription errors
# OLLAMA_FALLBACK_MODELS=gemma4:31b,gpt-oss:20b,gpt-oss:120b,gemma3:12b

# Optional override: llamacpp | ollama | opencode-go | home-agent | hermes
# LLM_PROVIDER=ollama
# When OpenCode is keyed: try it after Ollama models fail (and vice versa if LLM_PROVIDER=opencode-go)
LLM_FALLBACK=opencode-go

# --- Intel AI Playground Home Agent (LAN local-web) ---
# Use studio pipeline presets (Cloud / Playground / Hybrid / Playground Agent).
# HA port ≠ Comfy port — e.g. HA :8777, Comfy :8188 for H3 weights.
# HOME_AGENT_URL=http://192.168.4.34:8777
# HOME_AGENT_PASSWORD=
# HOME_AGENT_TIMEOUT=300

# --- Hermes Agent director (optional) ---
# HERMES_URL=http://127.0.0.1:8642
# HERMES_TOKEN=
# HERMES_MODEL=hermes
# See scenemux-skill/SKILL.md for Hermes operating SceneMux over HTTP.

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# --- ComfyUI / Comfy Cloud ---
# cloud | local | ai-playground
COMFYUI_BACKEND=cloud
# Local ComfyUI or Intel AI Playground queue
COMFYUI_URL=http://localhost:8188
COMFY_CLOUD_URL=https://cloud.comfy.org
COMFY_CLOUD_API_KEY=
# Project format default: mtv | typography
# VIDMUSE_PROJECT_MODE=mtv
# Optional overrides — generation stays inside ComfyUI + your LLM only
# COMFY_CHECKPOINT_TURBO=z_image_turbo_bf16.safetensors
# COMFY_ZIMAGE_CLIP=qwen_3_4b.safetensors
# COMFY_ZIMAGE_VAE=ae.safetensors
# Video engine (studio video_model): minimax-h3 | fasth3 | ltx23 | hybrid_fast | hybrid_ltx
# Same graphs run on Comfy Cloud OR local/AI Playground via COMFYUI_URL
COMFY_VIDEO_BACKEND=minimax-h3
# Optional FAL free-tier draft host (Advanced UI only — not required for Cloud/Playground)
# What: https://fal.ai — third-party draft stills/clips; SceneMux still muxes your song
# Get a key: https://fal.ai/dashboard/keys  then restart the API after setting FAL_KEY
# FAL_KEY=
# FAL_MAX_CONCURRENT=1
# FAL_VIDEO_MODEL=fal-ai/minimax/video-01-live
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# Wan2.1 InfiniteTalk (image + audio → singing / lip-sync performance)
# COMFY_INFINITETALK_UNET=wan2.1_i2v_480p_14B_fp8_scaled.safetensors
# COMFY_INFINITETALK_PATCH=wan2.1_infiniteTalk_single_fp16.safetensors
# COMFY_INFINITETALK_AUDIO_ENC=wav2vec2_large_english_fp16.safetensors
# COMFY_INFINITETALK_FPS=25
# COMFY_INFINITETALK_STEPS=24
# COMFY_INFINITETALK_CFG=5.0
# Stronger mouth drive (1.2–1.5 typical)
# COMFY_INFINITETALK_AUDIO_SCALE=1.35
# Seconds per InfiniteTalk chunk; scenes are covered by sequential chunks
# COMFY_INFINITETALK_CLIP_SECONDS=3.5
# COMFY_INFINITETALK_MAX_CHUNKS=4
# COMFY_INFINITETALK_MAX_FRAMES=81
# MiniMax H3 Reference-to-Video (local ComfyUI ≥ 0.30; HF Comfy-Org/MiniMax-H3)
# Place files under ComfyUI/models/{diffusion_models,text_encoders,vae}/
# COMFY_H3_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors
# COMFY_H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
# COMFY_H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
# COMFY_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
# COMFY_H3_FPS=24
# COMFY_H3_STEPS=20
# COMFY_H3_CLIP_SECONDS=5.0
# COMFY_H3_MAX_CHUNKS=3
# COMFY_H3_MAX_FRAMES=362
# COMFY_H3_WIDTH=768
# COMFY_H3_HEIGHT=448
# Optional 4-step turbo LoRA (ref2v):
# COMFY_H3_LIGHTNING=0
# COMFY_H3_LIGHTNING_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors
# FastVideo FastH3 8-step (ComfyUI ≥ 0.36) — I2V/T2V drafts only, NOT Ref2VA
# COMFY_FASTH3_UNET=fastvideo_fasth3_8step_v2_pruned_int8_convrot.safetensors
# COMFY_FASTH3_VIDEO_VAE=minimax_h3_video_vae_int8_convrot.safetensors
# COMFY_FASTH3_STEPS=8
# Shot mix default: hybrid | performance
# VIDMUSE_PERFORMANCE_MIX=hybrid
# How short clips fill their scene slot under the master track: freeze | loop | stretch
# Prefer freeze for Avatar lip-sync so mouths don't repeat under new lyrics
# VIDMUSE_CLIP_FILL=freeze
# LTX-2.3 IA2V (image+audio→video). Official template: video_ltx2_3_ia2v.json
# Distilled fp8 is the practical local default; swap to dev+lora for full template.
# COMFY_LTX_CKPT=ltx-2.3-22b-distilled-fp8.safetensors
# COMFY_LTX_TEXT_ENCODER=gemma_3_12B_it.safetensors
# COMFY_LTX_FPS=24
# COMFY_LTX_STEPS=8
# COMFY_LTX_CFG=1.0
# COMFY_LTX_I2V_STRENGTH=0.85
# COMFY_LTX_CLIP_SECONDS=4.0
# COMFY_LTX_MAX_FRAMES=97
# encode = official AudioVAEEncode path; reference = legacy ReferenceAudio guidance
# COMFY_LTX_AUDIO_MODE=encode
# inplace | condition — image lock node (inplace matches official IA2V)
# COMFY_LTX_I2V_NODE=inplace
# COMFY_LTX_AUDIO_IDENTITY=1.0
# Fallback HuMo lip-sync (used when COMFY_VIDEO_BACKEND=humo or primary fails):
# COMFY_HUMO_UNET=humo_17B_fp8_e4m3fn.safetensors
# Must be Whisper (not wav2vec) — HuMo reads encoder layer 32:
# COMFY_HUMO_AUDIO_ENC=whisper_large_v3_fp16.safetensors
# COMFY_HUMO_CLIP_SECONDS=2.0
# COMFY_HUMO_FPS=25
# COMFY_IMAGE_BACKEND=sdxl  # force SDXL turbo instead of Z-Image
# When refs are uploaded, Z-Image Omni (image inputs, no ReferenceLatent) is used.
# FaceID is NOT used by default — Comfy Cloud often lacks FaceID LoRA / ClipVision.
# COMFY_IDENTITY_BACKEND=faceid

# --- Full-song pipeline ---
# Target seconds per storyboard scene (3–4 min songs → more scenes)
VIDMUSE_SCENE_SECONDS=6
VIDMUSE_MAX_SCENES=48
VIDMUSE_MIN_SCENES=8
# Preview gate: render this many scenes first, then ask user to continue or redirect
VIDMUSE_PREVIEW_SCENES=3
# How short generated clips fill their longer scene slot: freeze | loop | stretch
# Prefer freeze so Avatar lip-sync does not loop under later lyrics
VIDMUSE_CLIP_FILL=freeze
