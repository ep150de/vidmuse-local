{
  "name": "LTX-2.3 Image-to-Video",
  "description": "LTX-2.3 image-to-video workflow for high-quality video generation from reference images. Uses advanced temporal attention and motion modeling for smooth, realistic video output.",
  "version": "1.0",
  "requires": {
    "ltx23_model": "LTX-2.3 checkpoint (ltx23_i2v.safetensors)",
    "reference_image": "Input image for video generation",
    "prompt": "Text description of desired motion",
    "comfyui_custom_nodes": [
      "ComfyUI-LTX",
      "ComfyUI-Vid2Vid",
      "ComfyUI-Motion-Module"
    ]
  },
  "workflow": {
    "1": {
      "inputs": {
        "ckpt_name": "ltx23_i2v.safetensors"
      },
      "class_type": "CheckpointLoaderSimple"
    },
    "2": {
      "inputs": {
        "text": "smooth camera movement, cinematic lighting, detailed motion",
        "clip": ["1", 0]
      },
      "class_type": "CLIPTextEncode"
    },
    "3": {
      "inputs": {
        "text": "",
        "clip": ["1", 0]
      },
      "class_type": "CLIPTextEncode"
    },
    "4": {
      "inputs": {
        "image_path": "",
        "resize_mode": "center_crop"
      },
      "class_type": "LoadImageForI2V"
    },
    "5": {
      "inputs": {
        "seed": 0,
        "steps": 40,
        "cfg": 3.5,
        "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras",
        "denoise": 0.9,
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["7", 0]
      },
      "class_type": "KSampler"
    },
    "6": {
      "inputs": {
        "samples": ["5", 0],
        "vae": ["1", 1]
      },
      "class_type": "VAEDecode"
    },
    "7": {
      "inputs": {
        "frame_count": 81,
        "width": 768,
        "height": 512
      },
      "class_type": "EmptyLTXLatentVideo"
    },
    "8": {
      "inputs": {
        "filename_prefix": "vidmuse_ltx23",
        "videos": ["6", 0],
        "fps": 24
      },
      "class_type": "SaveVideo"
    },
    "9": {
      "inputs": {
        "motion_strength": 0.7,
        "camera_motion": "horizontal_pan",
        "zoom": 0.3
      },
      "class_type": "LTXMotionModule"
    }
  },
  "usage": {
    "image_path": "Path to reference image for I2V generation",
    "prompt": "Text description of desired video motion and content",
    "num_frames": "Number of output frames (default 81, ~3.3s at 24fps)",
    "motion_strength": "Motion intensity (0.0-1.0), default 0.7",
    "camera_motion": "Camera movement type: none, pan_left, pan_right, zoom_in, zoom_out, tilt_up, tilt_down, or horizontal_pan",
    "output": "Generated video from image with applied motion"
  }
}
