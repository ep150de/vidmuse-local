# Generated by VidMuse setup wizard / copy to .env
# cp .env.example .env

# local | cloud
VIDMUSE_MODE=cloud

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
OUTPUT_DIR=./outputs

# --- LLM ---
# Cloud mode defaults OLLAMA_URL to https://ollama.com
# OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Optional override: llamacpp | ollama | opencode-go
# LLM_PROVIDER=ollama
LLM_FALLBACK=opencode-go

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# --- ComfyUI / Comfy Cloud ---
COMFYUI_BACKEND=cloud
# COMFYUI_URL=http://localhost:8188
COMFY_CLOUD_URL=https://cloud.comfy.org
COMFY_CLOUD_API_KEY=

# Local GGUF path (local mode / llama.cpp)
# GGUF_MODEL_PATH=./models/
